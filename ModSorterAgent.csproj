<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ModSorterAgent</AssemblyName>
    <RootNamespace>ModSorterAgent</RootNamespace>
    <CETCompat>false</CETCompat>

    <Version>1.0.0</Version>
    <Product>RimWorld 模组排序与冲突分析工作台</Product>
    <Authors>sanguodxj-byte</Authors>
    <Copyright>Copyright (c) 2026 sanguodxj-byte</Copyright>

    <!-- 反编译链路（ICSharpCode.Decompiler）依赖反射读取程序集，裁剪后会在运行时缺类型，禁止开启裁剪。 -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DecompilerServer\DecompilerServer.csproj" />
  </ItemGroup>

  <!-- GABS 以外部进程方式被调用，二进制随包分发；许可原件与二进制同包分发。 -->
  <ItemGroup>
    <None Include="..\GABS\gabs.exe" Condition="Exists('..\GABS\gabs.exe')"
          Link="GABS\gabs.exe"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\GABS\LICENSE" Condition="Exists('..\GABS\LICENSE')"
          Link="Licenses\GABS-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\DecompilerServer\LICENSE" Condition="Exists('..\DecompilerServer\LICENSE')"
          Link="Licenses\DecompilerServer-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
